#!/usr/bin/env bash
# Short repository search: default to text mode and auto-detect the search root.
#
# `restsift s QUERY` (or `ak s QUERY`) searches file contents for QUERY across
# the repository, resolving the root automatically (explicit ROOT > Git top-level
# > current dir) so the common case needs no mode word and no trailing `.`. A
# mode-selecting flag switches families; every other flag is forwarded verbatim
# to `restsift search`. This is sugar over `restsift search text QUERY <root>`.
#
# Usage:
#   restsift s QUERY [ROOT] [flags]         text search (default mode)
#   restsift s QUERY --tracked              search only git-tracked files
#   restsift s QUERY --changed              search only changed (worktree) files
#   restsift s QUERY --staged               search only staged files
#   restsift s QUERY --diff [--base REF]    search this branch's diff
#   restsift s QUERY --history [--messages] pickaxe git history for QUERY
#   restsift s QUERY --docs|--tests|--config|--deps   surface-scoped text search
#
# Example:
#   restsift s TODO                         # every TODO in the repo, no '.' needed
#   restsift s emit_json libexec            # scope the search to a subdirectory
#   restsift s export --changed             # only the files you changed
#   restsift s RestSift --history --messages
#   AI_OUTPUT=json restsift s emit_json     # stable JSON envelope for agents
#
# Canonical equivalent: `restsift s TODO` == `restsift search text TODO <root>`.
#
# Requires: git (root auto-detection; falls back to '.' outside a repo)
#
# Modes: text tracked changed-text staged-text diff history docs tests config deps
#
# Exit codes: mirror `restsift search`; 2 on a shorthand usage error. A search
#   that finds no matches still exits 0 (not grep-style 1) — an absent QUERY and a
#   match-all QUERY both return 0, so branch on the result set (stdout / the JSON
#   `results` array), not on exit status, to tell found-vs-not-found apart.

set -euo pipefail

# --- Early --help/-h guard.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    _self="${BASH_SOURCE[0]}"
    _here="$(cd "$(dirname "$_self")" && pwd)"
    [[ -x "$_here/sh-introspect" ]] && exec bash "$_here/sh-introspect" --format=help "$_self"
    sed -n '2,27p' "$_self" | sed 's/^# \{0,1\}//'
    exit 0
fi

# --- Early --introspect guard.
if [[ "${1:-}" == "--introspect" ]]; then
    _self="${BASH_SOURCE[0]}"
    _here="$(cd "$(dirname "$_self")" && pwd)"
    exec env AI_OUTPUT=json bash "$_here/sh-introspect" "$_self"
fi

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEARCH="$SELF_DIR/ai-search"

fail() {
    printf 'restsift s: %s\n' "$1" >&2
    exit 2
}

# Flags that consume the following token as their value in `restsift search`.
# Kept in lockstep with lib/ai-search/parse-flags.sh so we forward "--flag value"
# as a pair and never mistake a flag value for a positional query/root.
value_flag() {
    case "$1" in
        --glob | --type | --exclude | --max-depth | --context | -C | \
            --before-context | -B | --after-context | -A | \
            --max-bytes | --max-results | --base | --lang) return 0 ;;
        *) return 1 ;;
    esac
}

mode="text"
positionals=()
passthrough=()

while (($# > 0)); do
    case "$1" in
        # Mode selectors (shorthand-only; last one wins).
        --tracked) mode="tracked" ;;
        --changed) mode="changed-text" ;;
        --staged) mode="staged-text" ;;
        --diff) mode="diff" ;;
        --history) mode="history" ;;
        --docs) mode="docs" ;;
        --tests) mode="tests" ;;
        --config) mode="config" ;;
        --deps) mode="deps" ;;
        *)
            if value_flag "$1"; then
                (($# >= 2)) || fail "flag '$1' requires a value"
                passthrough+=("$1" "$2")
                shift
            elif [[ "$1" == -* ]]; then
                passthrough+=("$1")
            else
                positionals+=("$1")
            fi
            ;;
    esac
    shift
done

# Root resolution: explicit second positional wins; else Git top-level; else '.'.
resolve_root() {
    git rev-parse --show-toplevel 2>/dev/null || printf '.'
}

# An empty/whitespace-only QUERY is a usage error, not a match-everything search.
if ((${#positionals[@]} > 0)) && [[ -z "${positionals[0]//[[:space:]]/}" ]]; then
    fail "a non-empty QUERY is required (e.g. 'restsift s TODO')"
fi

case "${#positionals[@]}" in
    0)
        fail "a QUERY is required (e.g. 'restsift s TODO')"
        ;;
    1)
        exec "${BASH:-bash}" "$SEARCH" "$mode" "${positionals[0]}" "$(resolve_root)" \
            ${passthrough[@]+"${passthrough[@]}"}
        ;;
    *)
        # Query + an explicit root (and any extras) — forward as-is so
        # `restsift search` applies its own positional validation.
        exec "${BASH:-bash}" "$SEARCH" "$mode" "${positionals[@]}" \
            ${passthrough[@]+"${passthrough[@]}"}
        ;;
esac
