#!/usr/bin/env bash
set -euo pipefail

# ai-search.sh — unified repository search entrypoint (thin facade).
#
# All logic lives in ordered modules under scripts/ai/internal/search/, sourced here
# in load order. The entrypoint only: records its own path (so modules resolve
# common.sh and the introspector relative to scripts/ai/), runs the bootstrap
# guards, loads the modules, and calls ai_search_main.
#
# Module map (load order):
#   00-bootstrap.sh        early --help/--introspect guards; source common.sh
#   10-contract.sh         usage() + help summary + envelope contract comments
#   20-state.sh            defaults, warning state, init_run_state()
#   25-modes.sh            mode taxonomy (is_*_mode, surface_globs)
#   40-output-json.sh      emit_json/fail/to_json_array/canonical_root/validate
#   45-results-rg.sh       rg-json + line-to-result transforms
#   50-results-context.sh  context enrichment + max-bytes trimming
#   30-parse-flags.sh      flag parser
#   35-parse-positionals.sh legacy aliases + query/root interpretation
#   55-scope-args.sh       case/pattern/scope args, ignore + global gitignore
#   60-guards.sh           tool/git-root guards
#   65-backend-files.sh    changed-files/staged-files/files
#   70-backend-text.sh     text/docs/tests/config/deps/tracked/changed/staged-text
#   75-backend-git.sh      diff/history
#   80-backend-curated.sh  todo/unsafe-patterns
#   85-backend-ast.sh      struct/symbols/class
#   90-doctor.sh           doctor
#   95-dispatch.sh         dispatch + output assembly + ai_search_main
#
# Load-order constraint: 40-output-json.sh defines emit_json() before fail();
# the parser (30) depends on validate_non_negative_int()/fail() (40); dispatch
# (95) depends on every prior module.

# Entrypoint path, exported so modules resolve common.sh and sibling tools
# relative to scripts/ai/ rather than scripts/ai/internal/search/.
#
# Usage:
#   restsift search <mode> [query] [root] [flags]
#   content modes (need a query): text tracked docs tests config deps diff history struct symbols class
#   file-list modes (no query):   files changed-files staged-files
#   curated modes (no query):     todo unsafe-patterns
#   special:                      doctor
#   batch:                        restsift search batch MODE QUERY [QUERY ...] [root] [flags]
#
# Example:
#   restsift search text "TODO" .                          # find every TODO across the tree (human output)
#   AI_OUTPUT=json restsift search text "emit_json" libexec # same search as the stable JSON envelope agents consume
#   restsift search tracked "ai_search_main" .             # search only git-tracked files (git grep, not rg)
#   restsift search changed-text "export" .                # grep ONLY the files you changed in the worktree
#   restsift search diff "emit_json" . --base main         # search this branch's diff against main
#   restsift search history "RestSift" . --messages        # pickaxe commit history for a string
#   restsift search text "function" libexec --count        # per-file match counts + summary{}
#   restsift search text "emit_json" libexec -C 2          # add 2 lines of context around each match
#   restsift search files config .                         # find files whose NAME contains "config" (fd)
#   restsift search todo .                                 # list curated TODO/FIXME/HACK/XXX markers
#   restsift search doctor                                 # check which search backends are available
#   restsift search capabilities                           # full mode/flag/env capability map
#   restsift search batch text foo bar .                   # run one MODE against several queries
#
# Modes: text tracked docs tests config config-key deps route changed-text
#   staged-text diff history struct symbols class function method interface
#   enum files changed-files staged-files todo unsafe-patterns doctor
#   capabilities batch
#
# Flags: --fixed --regex --pcre2 --ignore-case -i --case-sensitive --smart-case
#   --glob --type --exclude --max-depth --absolute --no-ignore --no-ignore-vcs
#   --no-ignore-global --no-ignore-parent --no-ignore-dot --context -C
#   --before-context -B --after-context -A --files-with-matches -l --count
#   --count-matches --max-results --max-bytes --staged --base --messages --patch
#   --lang --dry-run --introspect --help -h
#
# The flag list is declared explicitly (not left to sh-introspect's auto-scan)
# because that scan's regex skips any flag containing a digit, such as --pcre2;
# keep this list in sync with lib/ai-search/parse-flags.sh case labels.
#
# Exit codes: 0 = ok | no_matches | dry_run | blocked | unavailable (read the
#   envelope status field to distinguish these; an empty result set is
#   status=no_matches at exit 0, NOT an error); 1 = error (bad flag/mode,
#   missing required tool, not a git repository, invalid regex).
AI_SEARCH_ENTRYPOINT="${BASH_SOURCE[0]}"
export AI_SEARCH_ENTRYPOINT

if [[ "${1:-}" == "capabilities" ]]; then
    shift
    _search_here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    exec "${BASH:-bash}" "$_search_here/ai-search-introspect" "$@"
fi

if [[ "${1:-}" == "batch" ]]; then
    shift
    _search_here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    exec "${BASH:-bash}" "$_search_here/ai-search-multi" "$@"
fi

_search_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/../lib/ai-search"

# shellcheck source=lib/ai-search/bootstrap.sh
source "$_search_dir/bootstrap.sh"
# shellcheck source=lib/ai-search/contract.sh
source "$_search_dir/contract.sh"
# shellcheck source=lib/ai-search/state.sh
source "$_search_dir/state.sh"
# shellcheck source=lib/ai-search/modes.sh
source "$_search_dir/modes.sh"
# shellcheck source=lib/ai-search/output-json.sh
source "$_search_dir/output-json.sh"
# shellcheck source=lib/ai-search/results-rg.sh
source "$_search_dir/results-rg.sh"
# shellcheck source=lib/ai-search/results-context.sh
source "$_search_dir/results-context.sh"
# shellcheck source=lib/ai-search/parse-flags.sh
source "$_search_dir/parse-flags.sh"
# shellcheck source=lib/ai-search/parse-positionals.sh
source "$_search_dir/parse-positionals.sh"
# shellcheck source=lib/ai-search/scope-args.sh
source "$_search_dir/scope-args.sh"
# shellcheck source=lib/ai-search/guards.sh
source "$_search_dir/guards.sh"
# shellcheck source=lib/ai-search/backend-files.sh
source "$_search_dir/backend-files.sh"
# shellcheck source=lib/ai-search/backend-text.sh
source "$_search_dir/backend-text.sh"
# shellcheck source=lib/ai-search/backend-git.sh
source "$_search_dir/backend-git.sh"
# shellcheck source=lib/ai-search/backend-curated.sh
source "$_search_dir/backend-curated.sh"
# shellcheck source=lib/ai-search/backend-ast.sh
source "$_search_dir/backend-ast.sh"
# shellcheck source=lib/ai-search/doctor.sh
source "$_search_dir/doctor.sh"
# shellcheck source=lib/ai-search/dispatch.sh
source "$_search_dir/dispatch.sh"

ai_search_main "$@"
