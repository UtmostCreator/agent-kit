#!/usr/bin/env bash
# Canonical repository-metadata command group (thin router).
#
# Routes `agent-kit repo <mode> ...` to the underlying repository-inspection
# engine for that mode. Every engine stays a complete, directly-runnable
# script under libexec/; this router only removes the need to remember which
# top-level name reports which kind of repository metadata (defined tasks vs.
# tracked-file counts vs. the whole command catalog vs. uncommitted doc drift).
#
# Usage:
#   agent-kit repo tasks [list|verify|test|lint|typecheck|json]  (ai-task)
#   agent-kit repo stats                                         (repo-stats)
#   agent-kit repo tools [--json]                                (repo-tool-inventory)
#   agent-kit repo status                                        (ai-file-freshness)
#
# Example:
#   agent-kit repo tasks list    # list every task this project already defines
#   agent-kit repo stats         # count files Git currently tracks
#   agent-kit repo tools         # see every command and what it does
#   agent-kit repo status        # list uncommitted changes under docs/, .github/, AGENTS.md

set -euo pipefail

_repo_here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

_repo_route() {
    local target="$1"
    shift
    exec "${BASH:-bash}" "$_repo_here/$target" "$@"
}

case "${1:-}" in
tasks)
    shift
    _repo_route ai-task "$@"
    ;;
stats)
    shift
    _repo_route repo-stats "$@"
    ;;
tools)
    shift
    _repo_route repo-tool-inventory "$@"
    ;;
status)
    shift
    _repo_route ai-file-freshness "$@"
    ;;
--help | -h | "")
    sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
*)
    echo "agent-kit repo: unknown mode '$1' (expected tasks|stats|tools|status)" >&2
    exit 2
    ;;
esac
