#!/usr/bin/env bash
# Canonical repository-metadata command group (thin router).
#
# Routes `restsift repo <mode> ...` to the underlying repository-inspection
# engine for that mode. Every engine stays a complete, directly-runnable
# script under libexec/; this router only removes the need to remember which
# top-level name reports which kind of repository metadata (defined tasks vs.
# tracked-file counts vs. the whole command catalog vs. uncommitted doc drift).
#
# Invoked either as `restsift repo <mode>` or, equivalently, by its libexec
# name `ai-repo <mode>`; both entry points route identically.
#
# Usage:
#   restsift repo tasks [list|verify|test|lint|typecheck|json]  (ai-task)
#   restsift repo stats                                         (repo-stats)
#   restsift repo tools [--json]                                (repo-tool-inventory)
#   restsift repo status                                        (ai-file-freshness)
#
# Modes: tasks stats tools status
#
# Example:
#   restsift repo tasks list    # list every task this project already defines
#   restsift repo stats         # count files Git currently tracks
#   restsift repo tools         # see every command and what it does
#   restsift repo status        # list uncommitted changes under docs/, .github/, AGENTS.md

set -euo pipefail

_repo_here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

_repo_route() {
    local target="$1"
    shift
    exec "${BASH:-bash}" "$_repo_here/$target" "$@"
}

case "${1:-}" in
    tasks)
        shift
        _repo_route ai-task "$@"
        ;;
    stats)
        shift
        _repo_route repo-stats "$@"
        ;;
    tools)
        shift
        _repo_route repo-tool-inventory "$@"
        ;;
    status)
        shift
        _repo_route ai-file-freshness "$@"
        ;;
    --introspect)
        exec env AI_OUTPUT=json "${BASH:-bash}" "$_repo_here/sh-introspect" "${BASH_SOURCE[0]}"
        ;;
    --help | -h | "")
        sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "restsift repo: unknown mode '$1' (expected tasks|stats|tools|status)" >&2
        echo "Run 'restsift repo --help' for usage and examples." >&2
        exit 2
        ;;
esac
