#!/usr/bin/env bash
# ai-git — canonical git-inspection command group (thin loader).
#
# Fuses the former git-branch-origin, git-forensics, and gh-pr-context engines
# into one canonical entrypoint. All logic lives in lib/ai-git/*.sh, sourced
# here in load order; each mode is dispatched to its module's *_main function.
#
# Usage:
#   restsift git origin [--json] [--field name|base|count|all]
#   restsift git history MODE TARGET [file] [--json]   (MODE: S|G|L)
#   restsift git blame LINES FILE [--json]
#   restsift git pr-context NUMBER [--diff] [--checks] [--reviews] [--pack] [--json]
#   restsift git files [SELECTOR...] [PATHSPEC] [--name-only] [--json] [-0]
#   restsift git conflicts [FOLDER] [--json] [--fail-on-findings]
#
# Modes: origin history blame pr-context files conflicts
#
# Example:
#   restsift git origin                          # print the branch your branch was created from
#   restsift git history S "TODO" README.md      # find commits that added/removed "TODO"
#   restsift git blame 1,20 README.md            # annotate who last changed lines 1-20
#   restsift git pr-context 123 --checks         # show PR #123 metadata plus CI check status
#   restsift git files --staged --name-only      # list staged paths, one per line
#   restsift git conflicts --fail-on-findings     # scan for <<<<<<< / ======= / >>>>>>> markers
#
# Exit codes:
#   0    success
#   1    usage/validation error (bad flag or --field, missing argument)
#   2    unknown mode
#   3    conflicts --fail-on-findings found markers
#   128  git passthrough failure (e.g. blame LINES out of range)
#   129  git usage error (e.g. malformed blame LINES spec)
#   5    gh/network passthrough error (pr-context)

set -euo pipefail

AI_GIT_LIBEXEC_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export AI_GIT_LIBEXEC_DIR

# shellcheck source=lib/common.sh
source "$AI_GIT_LIBEXEC_DIR/../lib/common.sh"

_ai_git_dir="$AI_GIT_LIBEXEC_DIR/../lib/ai-git"

# shellcheck source=lib/ai-git/origin.sh
source "$_ai_git_dir/origin.sh"
# shellcheck source=lib/ai-git/forensics.sh
source "$_ai_git_dir/forensics.sh"
# shellcheck source=lib/ai-git/pr-context.sh
source "$_ai_git_dir/pr-context.sh"
# shellcheck source=lib/ai-git/status.sh
source "$_ai_git_dir/status.sh"

ai_git_usage() {
    sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    origin)
        shift
        ai_git_origin_main "$@"
        ;;
    history)
        shift
        ai_git_forensics_main "$@"
        ;;
    blame)
        shift
        ai_git_forensics_main blame "$@"
        ;;
    pr-context)
        shift
        ai_git_pr_context_main "$@"
        ;;
    files)
        shift
        ai_git_files_main "$@"
        ;;
    conflicts)
        shift
        ai_git_conflicts_main "$@"
        ;;
    --help | -h | "")
        ai_git_usage
        exit 0
        ;;
    *)
        echo "restsift git: unknown mode '$1' (expected origin|history|blame|pr-context|files|conflicts)" >&2
        exit 2
        ;;
esac
