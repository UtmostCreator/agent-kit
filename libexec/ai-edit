#!/usr/bin/env bash
# Guarded edit wrapper for broad repository modifications (thin loader).
#
# The implementation lives in numbered, load-ordered modules under
# lib/ai-edit/; this root file stays the public, registered entrypoint and
# its behavior is byte-for-byte identical to the previous monolithic
# version. Mutations run only inside ai_edit_main's apply branches.
#
# Usage:
#   restsift edit MODE ARGS... [root] [flags]         modes: ast-grep | comby | sd | patch
#   restsift edit apply MODE ARGS... [root] [flags]   same as above with an explicit "apply" prefix
#   restsift edit rollback ARGS...                    routes to ai-rollback (list|show|apply|prune)
#   flags: --dry-run (default, preview) | --apply | --verify
#
# Example:
#   restsift edit --help                                 # see every mode and flag, safely
#   restsift edit sd OldName NewName . --dry-run          # preview a rename, changing nothing
#   restsift edit apply sd OldName NewName . --dry-run    # same, with explicit "apply" prefix
#   restsift edit rollback list                           # list rollback snapshots (routes to ai-rollback)
#
# Modes: ast-grep comby sd patch apply rollback
#
# Requires: git

set -euo pipefail

# Early --introspect guard: emit this script's machine-readable JSON contract
# (static parse via sh-introspect) and exit before running any logic. --help is
# handled by this script's own dedicated early guard (curated usage text) below,
# before common.sh is sourced.
if [[ "${1:-}" == "--introspect" ]]; then
    _ai_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    _ai_self_tool="$_ai_self_dir/sh-introspect"
    if [[ -x "$_ai_self_tool" ]]; then
        exec env AI_OUTPUT=json "${BASH:-bash}" "$_ai_self_tool" "${BASH_SOURCE[0]}"
    fi
fi

# Early "rollback" routing guard: `restsift edit rollback ...` execs straight
# into the sibling, independently-runnable ai-rollback script as a separate
# process (same pattern as ai-search's "capabilities" shim). ai-rollback is
# this toolkit's safety-recovery mechanism and stays a fully separate engine
# on purpose; this is dispatch only, never logic fusion. Everything after
# "rollback" is ai-rollback's own native argument grammar (list|show|apply|prune),
# unchanged.
if [[ "${1:-}" == "rollback" ]]; then
    shift
    _ai_edit_here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    exec "${BASH:-bash}" "$_ai_edit_here/ai-rollback" "$@"
fi

# Early "apply" prefix guard: `restsift edit apply MODE ARGS...` is an
# additive alias of the existing `restsift edit MODE ARGS...` form. Dropping
# the leading "apply" token here lets the rest of the arguments flow into the
# unchanged mode-dispatch logic below exactly as before; the bare MODE form
# (no "apply" prefix) keeps working unchanged too.
if [[ "${1:-}" == "apply" ]]; then
    shift
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
    cat <<'EOF'
ai-edit.sh — guarded repository edit entrypoint

Usage:
  ai-edit.sh MODE ARGS... [root] [flags]
  ai-edit.sh apply MODE ARGS... [root] [flags]   alias of the form above
  ai-edit.sh rollback ARGS...                    routes to ai-rollback (list|show|apply|prune)
  ai-edit.sh ast-grep LANG PATTERN REWRITE [root] [flags]
  ai-edit.sh comby MATCH REWRITE [root] [flags]
  ai-edit.sh sd FROM TO [root] [flags]
  ai-edit.sh patch PATCH_FILE|- [root] [flags]

JSON output: AI_OUTPUT=json
  Under AI_OUTPUT=json (or --format json) every exit path — including error,
  blocked, limit_exceeded and unavailable — emits exactly one ai.edit/v1 JSON
  object on stdout (usage/diagnostics go to stderr). Non-terminal statuses also
  carry a "nextStep" hint describing the flag to re-run with.

Status values (status -> exit code):
  dry_run        0    preview only; nothing modified (re-run with --apply)
  applied        0    changes written
  verified       0    changes written and ai-verify passed
  no_matches     0    nothing matched the pattern
  verify_failed  1    changes written but ai-verify failed
  error          2    bad usage/arguments (unknown mode/flag/format, bad number)
  limit_exceeded 3    a --max-files/--max-replacements bound was exceeded
  blocked        4    a safety gate refused (dirty tree, unsafe patch path)
  unavailable  127    a required backend tool (ast-grep/comby/sd/rg) is missing

Working directory: git/session operations (dirty-file reporting, snapshot,
diff) run in the current working directory's repo, while sd/ast-grep planning
targets the [root] argument. Invoke ai-edit from within the target repository
so changedFiles reflects the tree actually edited; passing a [root] outside the
cwd's repo makes the reported changedFiles describe a different tree.

Modes:
  structural:
    ast-grep       AST-aware rewrite; uses ast-grep/sg
  text:
    comby          generic structural rewrite
    sd             regex replacement in files found by rg; fully planned before apply
  diff:
    patch          apply a validated unified diff from a file or stdin (-);
                   preflighted with git apply --check; unsafe/protected paths blocked

Params:
  scope:
    --glob VALUE+              include glob; repeatable
    --exclude VALUE+           exclude path/glob; repeatable; added to defaults

  bounds:
    --max-files VALUE          cap editable files; default 50
    --max-replacements VALUE   cap total replacements; default 500
    --max-bytes VALUE          skip files above N bytes; default 2000000

  safety:
    --dry-run                  preview only
    --apply                    apply changes
    --verify                   run ai-verify.sh after apply
    --no-verify                do not run ai-verify.sh
    --require-clean-tree       require clean tree before apply
    --allow-dirty-tree         allow dirty tree before apply

  output:
    --format json|text|help

  misc:
    --help | -h                show this help
    --introspect               print machine-readable JSON contract

Env: AI_OUTPUT APPLY VERIFY REQUIRE_CLEAN_TREE MAX_FILES MAX_REPLACEMENTS MAX_BYTES

Tools:
  primary: ast-grep comby git jq rg sd
  base utilities: awk cat sed sort wc
  mode-specific tools: see mode contract via --introspect

Examples:
  restsift edit sd OldName NewName . --dry-run
  restsift edit apply sd OldName NewName . --dry-run
  restsift edit sd OldName NewName . --apply --verify
  restsift edit ast-grep php 'old($A)' 'new($A)' . --dry-run
  restsift edit patch /tmp/agent.patch . --dry-run
  restsift edit patch - . --apply --verify < /tmp/agent.patch
  restsift edit rollback list
  restsift edit rollback show SNAPSHOT_ID

Machine contract: restsift edit --introspect
EOF
}

# Early --help/-h guard: emit this script's curated usage BEFORE sourcing
# common.sh, so the universal common.sh --help fallback does not shadow the
# richer bespoke help. --introspect is still handled by the common.sh guard
# (and by the parser's --introspect path) after sourcing.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

# shellcheck source=scripts/ai/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

_ai_edit_dir="$SCRIPT_DIR/../lib/ai-edit"
# shellcheck source=lib/ai-edit/helpers.sh
source "$_ai_edit_dir/helpers.sh"
# shellcheck source=lib/ai-edit/parse.sh
source "$_ai_edit_dir/parse.sh"
# shellcheck source=lib/ai-edit/plan-apply.sh
source "$_ai_edit_dir/plan-apply.sh"
# shellcheck source=lib/ai-edit/main.sh
source "$_ai_edit_dir/main.sh"

ai_edit_main "$@"
