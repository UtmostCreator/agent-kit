#!/usr/bin/env bash
# all-f-into-one.sh (formerly all_in_one.sh / combine_files.sh)
# Recursively collects filenames and contents, writes them to a single output file at project root.
# Prunes ignored directories (entire subtrees) and excludes selected files.
# Each file block (header + content + footer) is wrapped inside triple backticks.
# A pre-existing output file is rotated to a timestamped <name>.bak.<stamp> alongside it and left in place (prune old .bak files yourself).
#
# Usage:
#   restsift all-f-into-one            # run from a project root; writes combined_output.txt
#   restsift all-f-into-one --json     # same run; print a JSON result envelope (schema ai.all-f-into-one/v1)
#   AI_OUTPUT=json restsift all-f-into-one   # JSON result envelope (env form)
#   restsift all-f-into-one --help     # show this help (nothing is written)
#
# Example:
#   restsift all-f-into-one --help        # see what this does without combining anything
#   restsift all-f-into-one --introspect  # print the machine-readable JSON contract
#   restsift all-f-into-one --json | jq .files_combined   # confirm how many files were captured
#
# Flags: --json
#
# Environment:
#   AIO_OUTPUT_FILE         override the output path (default: <root>/combined_output.txt)
#   AIO_IGNORE_DIRS         extra directory NAMES to prune, space-separated (added to defaults)
#   AIO_IGNORE_FILE_NAMES   extra file basenames to exclude, space-separated (added to defaults)
#   AI_OUTPUT               set to "json" to emit the JSON result envelope
#
# Requires: find
#
# Exit codes: 0 on success (a combined file is written, even when zero files were
#   captured); 2 on an unknown argument. A prior run's rotated .bak is left in
#   the directory. The filesystem is written; nothing else is mutated.

set -euo pipefail

# Early --introspect guard: emit this script's machine-readable JSON contract
# (static parse via sh-introspect) and exit before running any logic. zsh-safe
# self-path via $0. The target script is parsed as text, never executed.
if [[ "${1:-}" == "--introspect" ]]; then
    _ai_introspect_self="$0"
    _ai_introspect_here="$(cd "$(dirname "$_ai_introspect_self")" && pwd)"
    if [[ -x "$_ai_introspect_here/sh-introspect" ]]; then
        exec env AI_OUTPUT=json bash "$_ai_introspect_here/sh-introspect" "$_ai_introspect_self"
    fi
    sed -n '2,31p' "$_ai_introspect_self" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Early --help/-h guard: emit this script's human-readable contract (the static
# introspector's compact --format=help view) and exit before running any logic.
# zsh-safe self-path via $0.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    _ai_help_self="$0"
    _ai_help_here="$(cd "$(dirname "$_ai_help_self")" && pwd)"
    if [[ -x "$_ai_help_here/sh-introspect" ]]; then
        exec bash "$_ai_help_here/sh-introspect" --format=help "$_ai_help_self"
    fi
    sed -n '2,31p' "$_ai_help_self" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Runtime flags: only --json (plus AI_OUTPUT=json) selects machine-readable output;
# --help/-h/--introspect are handled above. Reject anything else instead of
# silently ignoring it, and point the caller at --help.
json_mode=""
[[ "${AI_OUTPUT:-}" == "json" ]] && json_mode=1
for _a in "$@"; do
    case "$_a" in
        --json) json_mode=1 ;;
        --help | -h | --introspect) ;;
        *)
            printf 'all-f-into-one: unknown argument: %s\n' "$_a" >&2
            printf 'hint: this command takes no positional args; run `restsift all-f-into-one --help` (only --json is supported).\n' >&2
            exit 2
            ;;
    esac
done

# Minimal, dependency-free JSON string escaping (paths may contain quotes).
json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

root_dir="$(pwd)"
output_file="${AIO_OUTPUT_FILE:-${root_dir}/combined_output.txt}"
output_base="$(basename "$output_file")"

# Directories to ignore (by directory NAME at any depth). Entire trees are pruned.
# Callers may append extra names via AIO_IGNORE_DIRS (space-separated).
ignore_dirs=(
    ".git"
    "node_modules"
    ".venv"
    "dist"
    "build"
    ".next"
)
if [[ -n "${AIO_IGNORE_DIRS:-}" ]]; then
    # shellcheck disable=SC2206  # deliberate word-split of a space-separated list
    ignore_dirs+=(${AIO_IGNORE_DIRS})
fi

# Files to ignore by basename (name match anywhere).
# Callers may append extra names via AIO_IGNORE_FILE_NAMES (space-separated).
ignore_file_names=(
    ".DS_Store"
)
if [[ -n "${AIO_IGNORE_FILE_NAMES:-}" ]]; then
    # shellcheck disable=SC2206  # deliberate word-split of a space-separated list
    ignore_file_names+=(${AIO_IGNORE_FILE_NAMES})
fi

# Files to ignore by path suffix (relative-ending match)
# Examples:
#   "package-lock.json"
#   "yarn.lock"
#   "src/config/local.env"
ignore_file_paths=(
    # "package-lock.json"
    # "yarn.lock"
    # "src/config/local.env"
)

# Rotate old output
rotated_backup=""
if [[ -f "$output_file" ]]; then
    rotated_backup="${output_file}.bak.$(date +%Y%m%d-%H%M%S)"
    mv -- "$output_file" "$rotated_backup"
fi

# Create empty output file
: >"$output_file"

files_combined=0

append_file() {
    local file="$1"
    local rel="${file#"$root_dir"/}"
    {
        printf '```\n'
        printf '===== START FILE: %s =====\n' "$rel"
        cat -- "$file"
        printf '\n===== END FILE: %s =====\n' "$rel"
        printf '```\n\n'
    } >>"$output_file"
    files_combined=$((files_combined + 1))
}

# Build find arguments into the global `reply` array.
build_find_args() {
    local -a dir_prunes=() file_name_neg=() file_path_neg=()

    # Directory prune clause
    if ((${#ignore_dirs[@]} > 0)); then
        local d
        dir_prunes+=('(')
        for d in "${ignore_dirs[@]}"; do
            dir_prunes+=(-type d -name "$d" -o)
        done
        dir_prunes[-1]=')' # replace last -o
        dir_prunes+=(-prune -o)
    fi

    # File name negation clause
    if ((${#ignore_file_names[@]} > 0)); then
        local n
        file_name_neg+=('(')
        for n in "${ignore_file_names[@]}"; do
            file_name_neg+=(-name "$n" -o)
        done
        file_name_neg[-1]=')' # replace last -o
    fi

    # File path negation clause
    if ((${#ignore_file_paths[@]} > 0)); then
        local p
        for p in "${ignore_file_paths[@]}"; do
            file_path_neg+=(-path "*/$p" -o)
        done
        file_path_neg[-1]=')' # replace last -o
    fi

    # File clause
    local -a file_clause=(-type f)
    if ((${#file_name_neg[@]} > 0 || ${#file_path_neg[@]} > 0)); then
        file_clause+=('!' \()
        if ((${#file_name_neg[@]} > 0)); then
            file_clause+=("${file_name_neg[@]}")
            if ((${#file_path_neg[@]} > 0)); then
                file_clause+=(-o "${file_path_neg[@]}")
            fi
        else
            file_clause+=("${file_path_neg[@]}")
        fi
        file_clause+=(\))
    fi
    file_clause+=(-print0)

    reply=(${dir_prunes[@]+"${dir_prunes[@]}"} "${file_clause[@]}")
}

# Prepare find args
declare -a find_args
build_find_args
find_args=("${reply[@]}")

# Collect files and append
while IFS= read -r -d '' f; do
    [[ "$(basename "$f")" == "$output_base"* ]] && continue
    append_file "$f"
done < <(find "$root_dir" "${find_args[@]}")

# Total bytes written (dependency-free; leading whitespace stripped).
bytes="$(wc -c <"$output_file" 2>/dev/null | tr -d '[:space:]')"
[[ -n "$bytes" ]] || bytes=0

# Distinct signal when nothing was captured (empty or fully-pruned directory
# otherwise produces a silent 0-byte file). Written to stderr so default stdout
# stays byte-identical.
if ((files_combined == 0)); then
    printf 'all-f-into-one: note: no files were combined (empty or fully-pruned directory); wrote empty %s\n' "$output_file" >&2
fi

if [[ -n "$json_mode" ]]; then
    if [[ -n "$rotated_backup" ]]; then
        bak_json="\"$(json_escape "$rotated_backup")\""
    else
        bak_json="null"
    fi
    printf '{'
    printf '"schema":"ai.all-f-into-one/v1","status":"ok","tool":"restsift",'
    printf '"output_file":"%s","files_combined":%d,"bytes":%d,"rotated_backup":%s' \
        "$(json_escape "$output_file")" "$files_combined" "$bytes" "$bak_json"
    printf '}\n'
    exit 0
fi

# macOS notification (no-op on other systems)
if command -v osascript >/dev/null 2>&1; then
    osascript -e 'display notification "Combined file created successfully." with title "Combine Files"'
fi

echo "Success: Combined file created at: $output_file"
