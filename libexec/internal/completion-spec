#!/usr/bin/env bash
# Hidden aggregate command: emit the whole agent-kit command surface as one
# JSON document, built from `sh-introspect --format=json` (never from parsing
# `--help` text). Backs shell-completion generation (scripts/gen-completions.sh).
#
# Not registered as a public command — lives under libexec/internal/, which
# bin/agent-kit's dispatcher never resolves and `agent-kit --list` never shows
# (same convention as libexec/internal/repomix-context-tree).
#
# Usage:
#   libexec/internal/completion-spec            JSON: {program, commands[]}
#
# Example:
#   bash libexec/internal/completion-spec | jq '.commands[] | select(.name=="search")'
#
# Requires: jq
#
# Exit codes: 0 on success. Every libexec/* file is introspected once (never
#   executed); this is a one-time generation step, never run per keystroke.

set -euo pipefail

SELF_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIBEXEC_DIR="$(cd -- "$SELF_DIR/.." && pwd)"
INTROSPECT="$LIBEXEC_DIR/sh-introspect"
BASH_BIN="${BASH:-bash}"

entries=()
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    name="$(basename "$f")"
    # Hide the introspector itself: a developer tool, not a workflow command.
    [[ "$name" == "sh-introspect" ]] && continue
    friendly="${name#ai-}"
    json="$("$BASH_BIN" "$INTROSPECT" --format=json "$f" 2>/dev/null || true)"
    [[ -n "$json" ]] || continue
    entries+=("$(printf '%s' "$json" | jq -c --arg name "$friendly" \
        '{name: $name, description: .description, modes: .modes, flags: .flags}')")
done < <(find "$LIBEXEC_DIR" -maxdepth 1 -type f | sort)

printf '%s\n' "${entries[@]}" | jq -sc \
    '{schema_version: 1, program: {name: "agent-kit", aliases: ["ak"]}, commands: .}'
