#!/usr/bin/env bash
# preview-file.sh — safely preview a slice of a text file with guardrails
# (size/byte gate, binary + .git blocking, column truncation).
#
# Usage:
#   preview-file FILE [--plain] [--lines N] [--range A:B] [--around L --context N]
#                     [--dry-run] [--force] [--max-bytes N] [--max-columns N]
#   Exit codes: 0 ok (or --dry-run previewable) - 1 gate blocked / file not found - 2 usage error
#   AI_OUTPUT=json emits a {"schema":"1","status":...,"tool":"preview-file",...} envelope on stdout.
#
# Modes: range around lines dry-run
#
# Example:
#   restsift preview-file README.md                # show the first 200 lines, safely
#   restsift preview-file README.md --range 1:40   # show only lines 1-40 of the file
#   restsift preview-file README.md --dry-run      # check a file is previewable (no content)

set -euo pipefail

# shellcheck source=scripts/ai/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

usage() {
    cat <<'EOF'
Usage:
  preview-file.sh FILE [--plain] [--lines N] [--range A:B] [--around L --context N]
                  [--dry-run] [--force] [--max-bytes N] [--max-columns N]

Notes:
  --max-bytes N  Raise the default 64KiB raw-file safety gate (e.g. --max-bytes 200000)
                 for a known-large file. --range does not bypass this gate.
  --force        Exceptional bypass of the safety/binary gates. Use only when the file
                 must be inspected despite the gate, and state why in your report.

Exit codes:
  0  preview shown, or --dry-run reports the file is previewable
  1  a safety gate blocked the file (size/binary/.git), or the file was not found
  2  usage error (missing value for a flag, unknown flag, or missing FILE)

Under AI_OUTPUT=json every result (success and error alike) is a single-line JSON
envelope on stdout: {"schema":"1","status":...,"tool":"preview-file",...}. Error
envelopes carry the reason in .errors[]; dry-run adds "previewable": true.
EOF
}

emit_json() {
    local status="$1" path="$2" content="$3" errors="${4:-[]}" warnings="${5:-[]}"
    # Optional metadata (defaults keep error/early-exit callers valid).
    local range_start="${6:-}" range_end="${7:-}" total_lines="${8:-0}" truncated="${9:-false}"
    local size_bytes="${10:-0}" max_bytes_lim="${11:-0}" max_columns_lim="${12:-0}"
    jq -cn \
        --arg schema "1" \
        --arg status "$status" \
        --arg tool "preview-file" \
        --arg path "$path" \
        --arg content "$content" \
        --argjson errors "$errors" \
        --argjson warnings "$warnings" \
        --arg range_start "$range_start" \
        --arg range_end "$range_end" \
        --argjson total_lines "$total_lines" \
        --argjson truncated "$truncated" \
        --argjson size_bytes "$size_bytes" \
        --argjson max_bytes_lim "$max_bytes_lim" \
        --argjson max_columns_lim "$max_columns_lim" \
        '{
            schema: $schema,
            status: $status,
            tool: $tool,
            path: $path,
            range: (if $range_start == "" then null else {start: ($range_start|tonumber), end: ($range_end|tonumber)} end),
            total_lines: $total_lines,
            truncated: $truncated,
            content: $content,
            limits: {max_bytes: $max_bytes_lim, max_columns: $max_columns_lim},
            warnings: $warnings,
            errors: $errors,
            meta: {size_bytes: $size_bytes}
        }'
}

# Build a one-element JSON array for an error message that may contain quotes
# or other JSON-significant characters (jq handles the escaping).
err_arr() { jq -cn --arg m "$1" '[$m]'; }

parse_size() {
    local raw="${1:-0}"
    raw="${raw// /}"
    if [[ "$raw" =~ ^([0-9]+)([KkMmGg])$ ]]; then
        local n="${BASH_REMATCH[1]}"
        case "${BASH_REMATCH[2],,}" in
            k) echo $((n * 1024)) ;;
            m) echo $((n * 1024 * 1024)) ;;
            g) echo $((n * 1024 * 1024 * 1024)) ;;
        esac
    else
        echo "$raw"
    fi
}

json_mode="${AI_OUTPUT:-}"

# Clean, JSON-aware error for a value-taking flag given without its value.
# Guards the `shift 2` below, which would otherwise fail under set -e and abort
# the script with no message when only the flag (and no value) remains.
missing_value() {
    if [[ "$json_mode" == "json" ]]; then
        emit_json "error" "$file" "" "[\"missing value for $1\"]"
    else
        echo "[ERROR] missing value for $1" >&2
    fi
    exit 2
}

file=""
plain=0
dry_run=0
force=0
lines=""
range=""
around=""
context=3
max_bytes_raw="65536"
max_columns=200

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help | -h)
            usage
            exit 0
            ;;
        --plain)
            plain=1
            shift
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        --force)
            force=1
            shift
            ;;
        --lines)
            [[ $# -ge 2 ]] || missing_value "$1"
            lines="${2:-}"
            shift 2
            ;;
        --lines=*)
            lines="${1#*=}"
            shift
            ;;
        --range)
            [[ $# -ge 2 ]] || missing_value "$1"
            range="${2:-}"
            shift 2
            ;;
        --range=*)
            range="${1#*=}"
            shift
            ;;
        --around)
            [[ $# -ge 2 ]] || missing_value "$1"
            around="${2:-}"
            shift 2
            ;;
        --around=*)
            around="${1#*=}"
            shift
            ;;
        --context)
            [[ $# -ge 2 ]] || missing_value "$1"
            context="${2:-3}"
            shift 2
            ;;
        --context=*)
            context="${1#*=}"
            shift
            ;;
        --max-bytes)
            [[ $# -ge 2 ]] || missing_value "$1"
            max_bytes_raw="${2:-65536}"
            shift 2
            ;;
        --max-bytes=*)
            max_bytes_raw="${1#*=}"
            shift
            ;;
        --max-columns)
            [[ $# -ge 2 ]] || missing_value "$1"
            max_columns="${2:-200}"
            shift 2
            ;;
        --max-columns=*)
            max_columns="${1#*=}"
            shift
            ;;
        --*)
            if [[ "$json_mode" == "json" ]]; then
                emit_json "error" "" "" "[\"unknown option: $1\"]"
                exit 1
            fi
            die "unknown option: $1"
            ;;
        *)
            if [[ -z "$file" ]]; then
                file="$1"
                shift
            elif [[ "$json_mode" == "json" ]]; then
                emit_json "error" "$file" "" "[\"unexpected arg: $1\"]"
                exit 1
            else die "unexpected arg: $1"; fi
            ;;
    esac
done

max_bytes="$(parse_size "$max_bytes_raw")"

if [[ -z "$file" ]]; then
    if [[ "$json_mode" == "json" ]]; then
        emit_json "error" "" "" '["missing FILE argument"]'
        exit 2
    fi
    usage
    exit 2
fi

if [[ ! -f "$file" ]]; then
    if [[ "$json_mode" == "json" ]]; then
        emit_json "error" "$file" "" '["file not found"]'
    else
        echo "[ERROR] file not found: $file" >&2
    fi
    exit 1
fi

if [[ "$file" == *"/.git/"* || "$file" == .git/* ]]; then
    if [[ "$force" != "1" ]]; then
        if [[ "$json_mode" == "json" ]]; then
            emit_json "error" "$file" "" '[".git internals blocked"]'
        else
            echo "[ERROR] .git internals blocked" >&2
        fi
        exit 1
    fi
fi

size="$(wc -c <"$file" | tr -d ' ')"
if ((size > max_bytes)) && [[ "$force" != "1" ]]; then
    if [[ "$json_mode" == "json" ]]; then
        # Populate the known size and byte limit so a caller can decide whether
        # to retry with a higher --max-bytes instead of guessing.
        emit_json "error" "$file" "" \
            "$(err_arr "max-bytes exceeded: file is ${size} bytes, limit is ${max_bytes} (raise with --max-bytes or use --force)")" \
            '[]' "" "" 0 false "$size" "$max_bytes" "$max_columns"
    else
        echo "[ERROR] max-bytes exceeded: file is ${size} bytes, limit is ${max_bytes} (raise with --max-bytes or use --force)" >&2
    fi
    exit 1
fi

# Real binary detection: count NUL bytes via tr (avoid bash $'\x00' empty-string bug).
nul_count="$(LC_ALL=C tr -cd '\000' <"$file" | wc -c | tr -d ' ')"
if ((nul_count > 0)) && [[ "$force" != "1" ]]; then
    if [[ "$json_mode" == "json" ]]; then
        # Size is known here; surface it so callers see the file exists but was
        # gated as binary rather than assuming a zero-byte file.
        emit_json "error" "$file" "" '["binary file blocked (contains NUL bytes; use --force to override)"]' \
            '[]' "" "" 0 false "$size" "$max_bytes" "$max_columns"
    else
        echo "[ERROR] binary file blocked (contains NUL bytes; use --force to override)" >&2
    fi
    exit 1
fi

# Dry-run reports previewability only after the size and binary gates above, so
# a binary/oversize file that the real preview rejects is not falsely reported
# as previewable.
if [[ "$dry_run" == "1" ]]; then
    if [[ "$json_mode" == "json" ]]; then
        # Reaching here means the file cleared every previewability gate
        # (size + binary + .git), so a caller can trust "previewable": true.
        # Blocked files exit above with status "error" and the reason in
        # .errors[]. Include the known size/limits so the pre-flight is useful.
        emit_json "dry_run" "$file" "" '[]' '[]' "" "" 0 false \
            "$size" "$max_bytes" "$max_columns" | jq -c '. + {previewable: true}'
    else
        echo "dry-run"
    fi
    exit 0
fi

if [[ -n "$lines" ]] && ! [[ "$lines" =~ ^[0-9]+$ ]]; then
    if [[ "$json_mode" == "json" ]]; then
        emit_json "error" "$file" "" "$(err_arr "invalid --lines \"$lines\" (expected a non-negative integer)")"
    else
        echo "[ERROR] invalid --lines \"$lines\" (expected a non-negative integer)" >&2
    fi
    exit 1
fi

total_lines="$(wc -l <"$file" | tr -d ' ')"

if [[ -n "$range" ]]; then
    if ! [[ "$range" =~ ^([0-9]+):([0-9]+)$ ]]; then
        if [[ "$json_mode" == "json" ]]; then
            emit_json "error" "$file" "" "$(err_arr "invalid --range \"$range\" (expected A:B with non-negative integers)")"
        else
            echo "[ERROR] invalid --range \"$range\" (expected A:B with non-negative integers)" >&2
        fi
        exit 1
    fi
    start="${BASH_REMATCH[1]}"
    end="${BASH_REMATCH[2]}"
    if ((start > end)); then
        if [[ "$json_mode" == "json" ]]; then
            emit_json "error" "$file" "" "$(err_arr "invalid --range \"$range\" (start must be <= end)")"
        else
            echo "[ERROR] invalid --range \"$range\" (start must be <= end)" >&2
        fi
        exit 1
    fi
    content="$(sed -n "${start},${end}p" "$file")"
elif [[ -n "$around" ]]; then
    if ! [[ "$around" =~ ^[0-9]+$ ]]; then
        if [[ "$json_mode" == "json" ]]; then
            emit_json "error" "$file" "" "$(err_arr "invalid --around \"$around\" (expected a non-negative integer)")"
        else
            echo "[ERROR] invalid --around \"$around\" (expected a non-negative integer)" >&2
        fi
        exit 1
    fi
    if ! [[ "$context" =~ ^[0-9]+$ ]]; then
        if [[ "$json_mode" == "json" ]]; then
            emit_json "error" "$file" "" "$(err_arr "invalid --context \"$context\" (expected a non-negative integer)")"
        else
            echo "[ERROR] invalid --context \"$context\" (expected a non-negative integer)" >&2
        fi
        exit 1
    fi
    start=$((around - context))
    ((start < 1)) && start=1
    end=$((around + context))
    content="$(sed -n "${start},${end}p" "$file")"
elif [[ -n "$lines" ]]; then
    start=1
    end="$lines"
    # `sed -n '1,0p'` prints line 1, so requesting 0 lines must yield no output.
    if ((lines == 0)); then
        content=""
    else
        content="$(sed -n "1,${lines}p" "$file")"
    fi
else
    start=1
    end=200
    content="$(sed -n '1,200p' "$file")"
fi

# Column truncation: apply to both plain and JSON output so --max-columns
# bounds machine-readable payloads as documented.
truncated_content="$(printf '%s\n' "$content" | awk -v m="$max_columns" '{ if (length($0)>m) { print substr($0,1,m) " ...truncated" } else print }')"

# Flag when any displayed line was column-truncated.
if [[ "$truncated_content" != "$content" ]]; then
    truncated="true"
else
    truncated="false"
fi

if [[ "$json_mode" == "json" ]]; then
    emit_json "ok" "$file" "$truncated_content" '[]' '[]' \
        "$start" "$end" "$total_lines" "$truncated" \
        "$size" "$max_bytes" "$max_columns"
else
    if [[ "$plain" == "0" ]] && command_exists bat; then
        printf '%s\n' "$truncated_content" | bat --paging=never --style=plain --color=always
    else
        printf '%s\n' "$truncated_content"
    fi
fi
