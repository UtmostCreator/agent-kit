#!/usr/bin/env bash
# ai-test — canonical test-selection/execution command group (thin loader).
#
# Fuses the former ai-test-select, run-test-focused, and run-repo-tests engines
# into one canonical entrypoint. All logic lives in lib/ai-test/*.sh, sourced
# here in load order; each mode is dispatched to its module's *_main function.
#
# Usage:
#   restsift test select changed          tests touched by the current diff
#   restsift test select file PATH        tests related to one file
#   restsift test select symbol SYMBOL    tests related to a symbol
#   restsift test select json             alias of 'select changed' (same JSON)
#   restsift test run --filter <Pattern>  run a focused PHPUnit selection
#   restsift test run <path/to/Test.php>  run a focused PHPUnit selection
#   restsift test all                     run every discovered suite (heavy)
#
# Example:
#   restsift test select changed          # list tests for your current changes (read-only)
#   restsift test run --filter FooTest    # run only tests matching FooTest
#   restsift test all --help              # see options and defaults before running (safe)
#
# Modes: select run all
#
# Flags: --filter --help -h --introspect
#
# Exit codes:
#   0  success
#   2  usage error (unknown mode, or a missing required argument)
#   1  runtime/environment error (not inside a git worktree, missing test runner, failed suite)

set -euo pipefail

AI_TEST_LIBEXEC_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export AI_TEST_LIBEXEC_DIR

# shellcheck source=lib/common.sh
source "$AI_TEST_LIBEXEC_DIR/../lib/common.sh"

_ai_test_dir="$AI_TEST_LIBEXEC_DIR/../lib/ai-test"

# shellcheck source=lib/ai-test/select.sh
source "$_ai_test_dir/select.sh"
# shellcheck source=lib/ai-test/run-focused.sh
source "$_ai_test_dir/run-focused.sh"
# shellcheck source=lib/ai-test/run-all.sh
source "$_ai_test_dir/run-all.sh"

ai_test_usage() {
    sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    select)
        shift
        ai_test_select_main "$@"
        ;;
    run)
        shift
        ai_test_run_main "$@"
        ;;
    all)
        shift
        ai_test_all_main "$@"
        ;;
    --help | -h | "")
        ai_test_usage
        exit 0
        ;;
    *)
        echo "restsift test: unknown mode '$1' (expected select|run|all)" >&2
        exit 2
        ;;
esac
