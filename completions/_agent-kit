                            '--help' \
                            '--introspect' \
                            '--max-bytes' \
                            '--max-files' \
                            '--max-replacements' \
                            '--no-verify' \
                            '--require-clean-tree' \
                            '--verify' \
                            '*:path:_files'
                    fi
                    ;;

                fd-files)
