                            '--compress' \
                            '--help' \
                            '--introspect' \
                            '--multiplier' \
                            '--multiplier-label' \
                            '--no-compress' \
                            '--no-regen' \
                            '--output' \
                            '--regen' \
                            '--reserved-output' \
