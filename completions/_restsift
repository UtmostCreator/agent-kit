#compdef restsift res agent-kit ak
# restsift shell completion (zsh) — generated by scripts/gen-completions.sh
# from libexec/internal/completion-spec. Do not edit by hand.

_restsift()
{
    local context state line
    typeset -A opt_args

    local -a commands
    commands=(
        'all-f-into-one:all-f-into-one.sh (formerly all_in_one.sh / combine_files.sh) Recursively collects filenames and contents, writes them to a single output file at project root. Prunes ignored directories (entire subtrees) and excludes selected files. Each file block (header + content + footer) is wrapped inside triple backticks. A pre-existing output file is rotated to a timestamped <name>.bak.<stamp> alongside it and left in place (prune old .bak files yourself).'
        'completion:Print a generated shell-completion definition for restsift (and its short alias `res`) to stdout. Non-mutating it only prints a file, it never touches shell configuration or installs anything.'
        'context:ai-context — canonical context-building command group (thin loader).'
        'doctor:Report restsift installation and environment health for bug triage.'
        'edit:Guarded edit wrapper for broad repository modifications (thin loader).'
        'fd-files:Repo-aware file discovery wrapper. Finds files whose BASENAME contains QUERY as a literal substring (not a regex), under an optional search root (default the current directory), always skipping vendor/, node_modules/, dist/, .git/, and .repomix-context/. The fd backend and the ripgrep fallback present one identical contract. Exit code is 0 whenever the search ran -- INCLUDING when zero files matched; a nonzero exit means bad usage or a bad search root (e.g. it does not exist), never "no results".'
        'file-freshness:Show which docs/config files have uncommitted changes (git status of key paths).'
        'git:ai-git — canonical git-inspection command group (thin loader).'
        'inspect:Canonical read-only inspection command group (thin router).'
        'preview-file:preview-file.sh — safely preview a slice of a text file with guardrails (size/byte gate, binary + .git blocking, column truncation).'
        'refactor-scan:Flag refactor candidates rank files by scc complexity and functions by lizard NLOC.'
        'repo:Canonical repository-metadata command group (thin router).'
        'repo-stats:Count the files Git currently tracks in this repository.'
        'repo-tool-inventory:List every toolkit command with its one-line summary (a discoverable map). Exits 0 on success and 2 on a usage error (unknown flag or unexpected argument).'
        'repomix-profile-lab:repomix-profile-lab — measure a target under several repomix "profiles" and recommend the highest-fidelity profile that fits a token budget, using ONLY repomixs own exact token counts (o200k_base) — never a bytes/4 heuristic.'
        'rg-code:Production-grade code search wrapper with repo-aware defaults.'
        'rollback:Review and apply repository-local rollback snapshots created by AI tooling sessions.'
        's:Short repository search default to text mode and auto-detect the search root.'
        'search:ai-search.sh — unified repository search entrypoint (thin facade).'
        'search-introspect:ai-search-introspect.sh — print 100% of the modes, flags, env vars, and per-mode argument contracts that ai-search.sh and ai-search-multi.sh accept.'
        'search-multi:Batch wrapper around ai-search.sh run one safe search MODE against several queries in a single approved invocation.'
        'session:Canonical agent-session command group (thin router).'
        'session-checkpoint:Create a repository-local checkpoint using the shared snapshot system. Exit codes 0 = checkpoint created; 1 = not a git repository, the repository   has no commits yet, or the snapshot manifest could not be written.'
        'structured:Structured data query wrapper for AI agents. CSV mode auto-uses mlr or csvcut when present, else falls back to plain head. Set AI_OUTPUT=json to make validate-json/validate-yaml emit a machine-readable ai.ai-structured/v1 envelope on stdout (the human [OK] line stays on stderr).'
        'task:Project task discovery wrapper for AI agents.'
        'test:ai-test — canonical test-selection/execution command group (thin loader).'
        'verify:Project-aware verification gate for AI-driven changes (thin loader).'
        'watch-loop:Re-run a command automatically whenever watched files change (blocks until Ctrl-C).'
        'bundle:alias for all-f-into-one'
        'ckpt:alias for session-checkpoint'
        'comp:alias for completion'
        'ctx:alias for context'
        'data:alias for structured'
        'e:alias for edit'
        'fd:alias for fd-files'
        'fresh:alias for file-freshness'
        'g:alias for git'
        'i:alias for inspect'
        'peek:alias for preview-file'
        'rb:alias for rollback'
        'refactor:alias for refactor-scan'
        'rg:alias for rg-code'
        'si:alias for search-introspect'
        'sm:alias for search-multi'
        'stats:alias for repo-stats'
        't:alias for test'
        'tools:alias for repo-tool-inventory'
        'tsk:alias for task'
        'v:alias for verify'
        'w:alias for watch-loop'
    )

    _arguments -C \
        '1:command:->command' \
        '*::argument:->arguments'

    case "$state" in
        command)
            _describe 'restsift command' commands
            ;;

        arguments)
            case "$line[1]" in
                all-f-into-one|bundle)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '*:path:_files'
                    ;;

                completion|comp)
                    local -a modes
                    modes=(
                        'auto'
                        'bash'
                        'fish'
                        'zsh'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'completion mode' modes
                    else
                        _arguments \
                            '--help' \
                            '*:path:_files'
                    fi
                    ;;

                context|ctx)
                    local -a modes
                    modes=(
                        'diff'
                        'ensure'
                        'estimate'
                        'file'
                        'generate'
                        'pack'
                        'status'
                        'tree'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'context mode' modes
                    else
                        _arguments \
                            '--compress' \
                            '--help' \
                            '--introspect' \
                            '--multiplier' \
                            '--multiplier-label' \
                            '--no-compress' \
                            '--no-regen' \
                            '--output' \
                            '--regen' \
                            '--reserved-output' \
                            '--style' \
                            '*:path:_files'
                    fi
                    ;;

                doctor)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '--json' \
                        '*:path:_files'
                    ;;

                edit|e)
                    local -a modes
                    modes=(
                        'apply'
                        'ast-grep'
                        'comby'
                        'patch'
                        'rollback'
                        'sd'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'edit mode' modes
                    else
                        _arguments \
                            '--allow-dirty-tree' \
                            '--apply' \
                            '--dry-run' \
                            '--exclude' \
                            '--format' \
                            '--glob' \
                            '--help' \
                            '--introspect' \
                            '--max-bytes' \
                            '--max-files' \
                            '--max-replacements' \
                            '--no-verify' \
                            '--require-clean-tree' \
                            '--verify' \
                            '*:path:_files'
                    fi
                    ;;

                fd-files|fd)
                    _arguments \
                        '--help' \
                        '--hidden' \
                        '--introspect' \
                        '--json' \
                        '--type' \
                        '*:path:_files'
                    ;;

                file-freshness|fresh)
                    _arguments \
                        '--exit-code' \
                        '--help' \
                        '--introspect' \
                        '*:path:_files'
                    ;;

                git|g)
                    local -a modes
                    modes=(
                        'blame'
                        'conflicts'
                        'files'
                        'history'
                        'origin'
                        'pr-context'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'git mode' modes
                    else
                        _arguments \
                            '--checks' \
                            '--conflicts' \
                            '--diff' \
                            '--fail-on-findings' \
                            '--field' \
                            '--help' \
                            '--introspect' \
                            '--json' \
                            '--name-only' \
                            '--pack' \
                            '--reviews' \
                            '*:path:_files'
                    fi
                    ;;

                inspect|i)
                    local -a modes
                    modes=(
                        'data'
                        'file'
                        'shell'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'inspect mode' modes
                    else
                        _arguments \
                            '--help' \
                            '*:path:_files'
                    fi
                    ;;

                preview-file|peek)
                    local -a modes
                    modes=(
                        'around'
                        'dry-run'
                        'lines'
                        'range'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'preview-file mode' modes
                    else
                        _arguments \
                            '--around' \
                            '--context' \
                            '--dry-run' \
                            '--force' \
                            '--help' \
                            '--introspect' \
                            '--lines' \
                            '--max-bytes' \
                            '--max-columns' \
                            '--plain' \
                            '--range' \
                            '*:path:_files'
                    fi
                    ;;

                refactor-scan|refactor)
                    local -a modes
                    modes=(
                        'all'
                        'comments'
                        'complexity'
                        'dupes'
                        'nloc'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'refactor-scan mode' modes
                    else
                        _arguments \
                            '--all' \
                            '--ccn-threshold' \
                            '--changed' \
                            '--complexity-threshold' \
                            '--exclude-dir' \
                            '--ext' \
                            '--fail-on-error' \
                            '--fail-on-findings' \
                            '--files-from' \
                            '--folder' \
                            '--help' \
                            '--human' \
                            '--introspect' \
                            '--lang' \
                            '--markers' \
                            '--max-depth' \
                            '--nloc-threshold' \
                            '--no-parallel' \
                            '--no-report' \
                            '--output-dir' \
                            '--param-threshold' \
                            '--quiet' \
                            '--report-format' \
                            '--scc-format' \
                            '--strict' \
                            '--token-threshold' \
                            '*:path:_files'
                    fi
                    ;;

                repo)
                    local -a modes
                    modes=(
                        'stats'
                        'status'
                        'tasks'
                        'tools'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'repo mode' modes
                    else
                        _arguments \
                            '--help' \
                            '*:path:_files'
                    fi
                    ;;

                repo-stats|stats)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '*:path:_files'
                    ;;

                repo-tool-inventory|tools)
                    local -a modes
                    modes=(
                        'json'
                        'table'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'repo-tool-inventory mode' modes
                    else
                        _arguments \
                            '--help' \
                            '--introspect' \
                            '*:path:_files'
                    fi
                    ;;

                repomix-profile-lab)
                    _arguments \
                        '--budget' \
                        '--help' \
                        '--introspect' \
                        '--json' \
                        '*:path:_files'
                    ;;

                rg-code|rg)
                    local -a modes
                    modes=(
                        'all'
                        'blade'
                        'config'
                        'default'
                        'js'
                        'kotlin'
                        'php'
                        'tracked'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'rg-code mode' modes
                    else
                        _arguments \
                            '--context' \
                            '--count' \
                            '--files' \
                            '--help' \
                            '--ignore-case' \
                            '--introspect' \
                            '--json' \
                            '--mode' \
                            '--type' \
                            '-C' \
                            '-h' \
                            '*:path:_files'
                    fi
                    ;;

                rollback|rb)
                    local -a modes
                    modes=(
                        'apply'
                        'list'
                        'prune'
                        'show'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'rollback mode' modes
                    else
                        _arguments \
                            '--days' \
                            '--help' \
