                            '--json' \
                            '*:path:_files'
                    fi
                    ;;

                s)
                    local -a modes
                    modes=(
                        'changed-text'
                        'config'
                        'deps'
                        'diff'
                        'docs'
                        'history'
                        'staged-text'
                        'tests'
                        'text'
                        'tracked'
                    )
                    if ((CURRENT == 2)); then
                        _describe 's mode' modes
                    else
                        _arguments \
                            '--changed' \
                            '--config' \
                            '--deps' \
                            '--diff' \
                            '--docs' \
                            '--help' \
                            '--history' \
                            '--introspect' \
                            '--staged' \
                            '--tests' \
                            '*:path:_files'
                    fi
                    ;;

                search)
                    local -a modes
                    modes=(
                        'batch'
                        'capabilities'
                        'changed-files'
                        'changed-text'
                        'class'
                        'config'
                        'config-key'
                        'deps'
                        'diff'
                        'docs'
                        'doctor'
                        'enum'
                        'files'
                        'function'
                        'history'
                        'interface'
                        'method'
                        'route'
                        'staged-files'
                        'staged-text'
                        'struct'
                        'symbols'
                        'tests'
                        'text'
                        'todo'
                        'tracked'
                        'unsafe-patterns'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'search mode' modes
                    else
                        _arguments \
                            '--absolute' \
                            '--after-context' \
                            '--base' \
                            '--before-context' \
                            '--case-sensitive' \
                            '--context' \
                            '--count' \
                            '--count-matches' \
                            '--dry-run' \
                            '--exclude' \
                            '--files-with-matches' \
                            '--fixed' \
                            '--glob' \
                            '--help' \
                            '--ignore-case' \
                            '--introspect' \
                            '--lang' \
                            '--max-bytes' \
                            '--max-depth' \
                            '--max-results' \
                            '--messages' \
                            '--no-ignore' \
                            '--no-ignore-dot' \
                            '--no-ignore-global' \
                            '--no-ignore-parent' \
                            '--no-ignore-vcs' \
                            '--patch' \
                            '--pcre2' \
                            '--regex' \
                            '--smart-case' \
                            '--staged' \
                            '--type' \
                            '-A' \
                            '-B' \
                            '-C' \
                            '-h' \
                            '-i' \
                            '*:path:_files'
                    fi
                    ;;

                search-introspect|si)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '--json' \
                        '*:path:_files'
                    ;;

                search-multi|sm)
                    local -a modes
                    modes=(
                        'changed-files'
                        'changed-text'
                        'class'
                        'config'
                        'config-key'
                        'deps'
                        'diff'
                        'docs'
                        'enum'
                        'files'
                        'function'
                        'history'
                        'interface'
                        'method'
                        'route'
                        'staged-files'
                        'staged-text'
                        'struct'
                        'symbols'
                        'tests'
                        'text'
                        'todo'
                        'tracked'
                        'unsafe-patterns'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'search-multi mode' modes
                    else
                        _arguments \
                            '--help' \
                            '*:path:_files'
                    fi
                    ;;

                session)
                    local -a modes
                    modes=(
                        'checkpoint'
                        'watch'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'session mode' modes
                    else
                        _arguments \
                            '--help' \
                            '*:path:_files'
                    fi
                    ;;

                session-checkpoint|ckpt)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '*:path:_files'
                    ;;

                structured|data)
                    local -a modes
                    modes=(
                        'csv'
                        'json'
                        'validate-json'
                        'validate-yaml'
                        'xml'
                        'yaml'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'structured mode' modes
                    else
                        _arguments \
                            '--head' \
                            '--help' \
                            '--introspect' \
                            '*:path:_files'
                    fi
                    ;;

                task|tsk)
                    local -a modes
                    modes=(
                        'json'
                        'lint'
                        'list'
                        'test'
                        'todos'
                        'typecheck'
                        'verify'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'task mode' modes
                    else
                        _arguments \
                            '--help' \
                            '--introspect' \
                            '--json' \
                            '--pending' \
                            '*:path:_files'
                    fi
                    ;;

                test|t)
                    local -a modes
                    modes=(
                        'all'
                        'run'
                        'select'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'test mode' modes
                    else
                        _arguments \
                            '--filter' \
                            '--help' \
                            '--introspect' \
                            '*:path:_files'
                    fi
                    ;;

                verify|v)
                    local -a modes
                    modes=(
                        'docs'
                        'refs'
                    )
                    if ((CURRENT == 2)); then
                        _describe 'verify mode' modes
                    else
                        _arguments \
                            '--all' \
                            '--check' \
                            '--exclude' \
                            '--ext' \
                            '--format' \
                            '--help' \
                            '--introspect' \
                            '--json' \
                            '--language' \
                            '*:path:_files'
                    fi
                    ;;

                watch-loop|w)
                    _arguments \
                        '--help' \
                        '--introspect' \
                        '*:path:_files'
                    ;;

            esac
            ;;
    esac
}

compdef _restsift restsift res agent-kit ak
